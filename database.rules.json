{
  "rules": {
    ".read": "auth != null",
    ".write": false,
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen']) || newData.val() === true || newData.val() === false"
      }
    }
  }
}
