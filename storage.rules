rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Check if user is Admin
    function isAdmin() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // Helper: Is Image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Helper: Size Limit (e.g. 5MB)
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Profile Pictures
    match /profile_pictures/{userId} {
      allow read: if true;
      allow write: if request.auth != null && 
                   request.auth.uid == userId && 
                   isImage() && 
                   isUnder5MB();
    }

    // Chat Attachments
    match /chat_attachments/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && 
                   request.auth.uid == userId && 
                   isUnder5MB();
    }

    // Resources (Admin Only)
    match /resources/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
