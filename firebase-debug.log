[debug] [2026-01-03T20:54:47.331Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/obour-institutes-a607d/rulesets {"name":"projects/obour-institutes-a607d/rulesets/237a734f-c67b-4d36-b724-c0cb95c2f436","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Helper to check for Admin\r\n    function isAdmin() {\r\n      return request.auth != null && \r\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];\r\n    }\r\n    \r\n    // Helper to check for Owner\r\n    function isOwner() {\r\n      return request.auth != null && \r\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';\r\n    }\r\n\r\n    // User Profiles\r\n    match /users/{userId} {\r\n      allow read: if request.auth != null;\r\n      // User can write own profile, Admin can write non-admin profiles, Owner can write anyone\r\n      allow write: if request.auth != null && (\r\n        (request.auth.uid == userId && \r\n         // Prevent Privilege Escalation: User cannot change sensitive fields\r\n         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isWhitelisted', 'studentCode'])) ||\r\n        (isAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.role == 'student') ||\r\n        isOwner()\r\n      );\r\n    }\r\n\r\n    // Chat System (Support)\r\n    match /chats/{chatId} {\r\n      allow read, write: if request.auth != null && (request.auth.uid == chatId || isAdmin());\r\n      match /messages/{messageId} {\r\n        allow read, write: if request.auth != null && (request.auth.uid == chatId || isAdmin());\r\n      }\r\n    }\r\n\r\n    // Public Content (Subjects)\r\n    match /subjects/{subjectId} {\r\n      allow read: if request.auth != null;\r\n      allow write: if isAdmin();\r\n      match /resources/{resourceId} {\r\n        allow read: if request.auth != null;\r\n        allow write: if isAdmin();\r\n      }\r\n    }\r\n    \r\n    // Notifications: Read all authenticated, Admin Write\r\n    match /notifications/{notificationId} {\r\n      allow read: if request.auth != null;\r\n      allow write: if isAdmin();\r\n    }\r\n    \r\n    // Admin Whitelist - needed for AuthContext to check and auto-promote\r\n    match /whitelisted_admins/{email} {\r\n      // Only allow reading if the document ID matches the user's email\r\n      allow read: if request.auth != null && request.auth.token.email == email;\r\n      allow write: if isAdmin();\r\n    }\r\n    \r\n    // Banners - Public read for announcements\r\n    match /banners/{bannerId} {\r\n      allow read: if true;\r\n      allow write: if isAdmin();\r\n    }\r\n    \r\n    // System Logs\r\n    match /logs/{logId} {\r\n      allow read: if isAdmin();\r\n      allow delete: if isAdmin();\r\n      allow create: if request.auth != null;\r\n    }\r\n    \r\n    // System Errors\r\n    match /system_errors/{errorId} {\r\n      allow read: if isAdmin();\r\n      allow write: if isAdmin();\r\n      allow create: if request.auth != null; // Allow users to log errors\r\n    }\r\n    \r\n    // Default deny for anything else\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-01-03T20:54:48.322287Z","metadata":{"services":["cloud.firestore"]}}
