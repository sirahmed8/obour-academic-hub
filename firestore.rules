rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {



    // Helper to check for Owner
    function isOwner() {
      return request.auth != null && (
        request.auth.token.email == 'a7medorabe7@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') == 'owner')
      );
    }

    // Helper to check if user is whitelisted (replacing hardcoded email)
    function isWhitelisted() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/whitelisted_admins/$(request.auth.token.email));
    }

    // Helper for granular permissions
    function hasPermission(permission) {
      return request.auth != null && (
        isOwner() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         permission in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', []))
      );
    }

    // User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        isOwner() ||
        (request.auth.uid == userId && (
          isWhitelisted() ||
          (resource == null && (
            request.resource.data.role == 'student' &&
            !request.resource.data.keys().hasAny(['permissions', 'isWhitelisted'])
          )) ||
          (resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isWhitelisted']))
        )) ||
        (hasPermission('manage_users') && resource != null && resource.data.role == 'student')
      );
      
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Chat System (Support)
    match /chats/{chatId} {
      allow read: if request.auth != null && (request.auth.uid == chatId || hasPermission('access_inbox'));
      allow create: if request.auth != null && (request.auth.uid == chatId || hasPermission('access_inbox'));
      allow update: if request.auth != null && (request.auth.uid == chatId || hasPermission('access_inbox'));
      allow delete: if hasPermission('delete_chats');

      match /messages/{messageId} {
        allow read: if request.auth != null && (request.auth.uid == chatId || hasPermission('access_inbox'));
        allow create: if request.auth != null && (request.auth.uid == chatId || hasPermission('access_inbox'));
        allow update: if request.auth != null && (request.auth.uid == chatId || hasPermission('access_inbox'));
        allow delete: if hasPermission('delete_chats');
      }
    }

    // Public Content (Subjects)
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if hasPermission('manage_subjects');
      match /resources/{resourceId} {
        allow read: if request.auth != null;
        allow write: if hasPermission('manage_resources');
      }
    }
    
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        hasPermission('manage_announcements') || 
        resource.data.target == request.auth.uid || 
        resource.data.target == 'all'
      );
      allow create: if request.auth != null && (
        hasPermission('manage_announcements') || 
        request.resource.data.target == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        hasPermission('manage_announcements') ||
        resource.data.target == request.auth.uid
      );
    }
    
    match /whitelisted_admins/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || hasPermission('manage_users'));
      allow write: if hasPermission('manage_users');
    }

    match /admin_approvals/{requestId} {
      allow read, write: if hasPermission('manage_subjects') || hasPermission('manage_users');
    }
    
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if hasPermission('manage_announcements');
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner() || hasPermission('manage_users');
    }
    
    match /analytics_logs/{logId} {
      allow read: if hasPermission('view_analytics');
      allow delete: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
                   request.resource.data.keys().hasAll(['userId', 'path', 'timestamp']) &&
                   request.resource.data.keys().size() < 10 &&
                   (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'guest');
    }
    
    match /error_logs/{errorId} {
      allow read: if hasPermission('view_analytics');
      allow delete: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
                   request.resource.data.keys().hasAll(['message', 'timestamp']) &&
                   request.resource.data.keys().size() < 10;
    }
    
    match /logs/{logId} {
      allow read: if hasPermission('view_analytics');
      allow write: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
                   request.resource.data.keys().hasAll(['action', 'details']) &&
                   request.resource.data.keys().size() < 20 &&
                   request.resource.data.action is string &&
                   request.resource.data.details is string;
    }
    
    match /system_errors/{errorId} {
      allow read: if hasPermission('view_analytics');
      allow write: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
                   request.resource.data.keys().hasAll(['message']) &&
                   request.resource.data.keys().size() < 20 &&
                   request.resource.data.message is string;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
