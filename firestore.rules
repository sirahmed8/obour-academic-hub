rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function currentUserRole() {
      return ('role' in request.auth.token) ? request.auth.token.role :
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'student');
    }

    function isOwner() {
      return request.auth != null && currentUserRole() == 'owner';
    }

    function isAdminUser() {
      return request.auth != null &&
        (currentUserRole() == 'admin' || currentUserRole() == 'owner');
    }

    function hasPermission(permission) {
      return request.auth != null && (
        isOwner() ||
        (
          'permissions' in request.auth.token &&
          request.auth.token.permissions is list &&
          permission in request.auth.token.permissions
        )
      );
    }

    function isOwnChat(chatId) {
      return request.auth != null &&
        (chatId == request.auth.uid || chatId == request.auth.uid + '_support');
    }

    function isNotificationRecipient(target) {
      return request.auth != null && (
        target == request.auth.uid ||
        target == 'all' ||
        (target == 'admins' && isAdminUser())
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || hasPermission('manage_users'));

      allow create: if false;

      allow update: if request.auth != null && (
        isOwner() ||
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isWhitelisted', 'status']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points']) ||
            (
              request.resource.data.points is int &&
              (
                (!('points' in resource.data) && (request.resource.data.points == 2 || request.resource.data.points == 10 || request.resource.data.points == 25 || request.resource.data.points == 40 || request.resource.data.points == 50)) ||
                (('points' in resource.data) && (
                  request.resource.data.points - resource.data.points == 2 ||
                  request.resource.data.points - resource.data.points == 10 ||
                  request.resource.data.points - resource.data.points == -10 ||
                  request.resource.data.points - resource.data.points == 25 ||
                  request.resource.data.points - resource.data.points == 40 ||
                  request.resource.data.points - resource.data.points == 50
                ))
              )
            )
          )
        ) ||
        (hasPermission('manage_users') && resource.data.role in ['student', 'moderator'] && 
          request.resource.data.role in ['student', 'admin', 'moderator']) ||
        (hasPermission('manage_users') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );


      allow delete: if isOwner() || (hasPermission('manage_users') && resource.data.role != 'owner');

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow read, create, update: if request.auth != null &&
        (isOwnChat(chatId) || hasPermission('access_inbox'));
      allow delete: if request.auth != null &&
        (isOwnChat(chatId) || hasPermission('delete_chats'));

      match /messages/{messageId} {
        allow read, create, update: if request.auth != null &&
          (isOwnChat(chatId) || hasPermission('access_inbox'));
        allow delete: if request.auth != null &&
          (isOwnChat(chatId) || hasPermission('delete_chats'));
      }
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if hasPermission('manage_subjects');

      match /resources/{resourceId} {
        allow read: if request.auth != null;
        allow write: if hasPermission('manage_resources');
      }
    }

    match /global_chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.role in ['student', 'moderator', 'admin', 'owner'] &&
        request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && (
        (resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])) ||
        hasPermission('access_inbox') ||
        isOwner()
      );
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || hasPermission('delete_chats') || isOwner());
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        (hasPermission('manage_announcements') || isNotificationRecipient(resource.data.target));

      allow create: if request.auth != null && (
        hasPermission('manage_announcements') ||
        request.resource.data.target == request.auth.uid
      );

      allow update: if request.auth != null && (
        hasPermission('manage_announcements') ||
        (
          isNotificationRecipient(resource.data.target) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy is list &&
          request.auth.uid in request.resource.data.readBy
        )
      );

      allow delete: if request.auth != null && (
        hasPermission('manage_announcements') ||
        resource.data.target == request.auth.uid
      );
    }

    match /whitelisted_admins/{email} {
      allow read: if request.auth != null &&
        (request.auth.token.email == email || hasPermission('manage_users'));
      allow write: if hasPermission('manage_users');
    }

    match /admin_approvals/{requestId} {
      allow read, write: if hasPermission('manage_subjects') || hasPermission('manage_users');
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if hasPermission('manage_announcements');
    }

    match /settings/api_keys {
      allow read, write: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if settingId in ['global', 'platform_stats', 'banners'];
      allow write: if isOwner();
    }

    match /analytics_logs/{logId} {
      allow read: if hasPermission('view_analytics') || 
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['userId', 'timestamp']) &&
        request.resource.data.keys().size() < 15 &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'guest' || request.resource.data.userId.matches('^guest_.*$'));
    }

    match /user_stats/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdminUser());
      allow create: if request.auth != null && (
        isOwner() || 
        (request.auth.uid == userId &&
         (!('pageViews' in request.resource.data) || request.resource.data.pageViews == 1) &&
         (!('fileOpens' in request.resource.data) || request.resource.data.fileOpens == 1) &&
         (!('subjectOpens' in request.resource.data) || request.resource.data.subjectOpens == 1) &&
         (!('totalActions' in request.resource.data) || request.resource.data.totalActions == 1)
        )
      );
      allow update: if request.auth != null && (
        isOwner() ||
        (request.auth.uid == userId &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pageViews']) || 
          (request.resource.data.pageViews is int && request.resource.data.pageViews == (('pageViews' in resource.data) ? resource.data.pageViews + 1 : 1))) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fileOpens']) || 
          (request.resource.data.fileOpens is int && request.resource.data.fileOpens == (('fileOpens' in resource.data) ? resource.data.fileOpens + 1 : 1))) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subjectOpens']) || 
          (request.resource.data.subjectOpens is int && request.resource.data.subjectOpens == (('subjectOpens' in resource.data) ? resource.data.subjectOpens + 1 : 1))) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalActions']) || 
          (request.resource.data.totalActions is int && request.resource.data.totalActions == (('totalActions' in resource.data) ? resource.data.totalActions + 1 : 1)))
        )
      );
    }

    match /error_logs/{errorId} {
      allow read, delete: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['message', 'timestamp']) &&
        request.resource.data.keys().size() < 10;
    }

    match /logs/{logId} {
      allow read, write: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['action', 'details']) &&
        request.resource.data.keys().size() < 20 &&
        request.resource.data.action is string &&
        request.resource.data.details is string;
    }

    match /system_errors/{errorId} {
      allow read, write: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['message']) &&
        request.resource.data.keys().size() < 20 &&
        request.resource.data.message is string &&
        request.resource.data.timestamp is timestamp;
    }

    match /exams/{examId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['titleAr', 'titleEn', 'subject', 'year', 'type', 'downloadUrl']) &&
        request.resource.data.titleAr is string && request.resource.data.titleAr.size() > 0 && request.resource.data.titleAr.size() < 100 &&
        request.resource.data.titleEn is string && request.resource.data.titleEn.size() > 0 && request.resource.data.titleEn.size() < 100 &&
        request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() < 100 &&
        request.resource.data.year is string && request.resource.data.year.size() > 0 && request.resource.data.year.size() < 10 &&
        request.resource.data.type in ['Midterm', 'Final'] &&
        request.resource.data.downloadUrl is string && request.resource.data.downloadUrl.size() > 0 && request.resource.data.downloadUrl.size() < 1000;
      allow update, delete: if hasPermission('manage_subjects') || isOwner();
    }

    match /hagazSessions/{sessionId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['titleAr', 'titleEn', 'subject', 'time', 'date', 'seats', 'bookedSeats', 'type', 'mentor', 'createdBy']) &&
        request.resource.data.titleAr is string && request.resource.data.titleAr.size() > 0 && request.resource.data.titleAr.size() < 100 &&
        request.resource.data.titleEn is string && request.resource.data.titleEn.size() > 0 && request.resource.data.titleEn.size() < 100 &&
        request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() < 100 &&
        request.resource.data.time is string && request.resource.data.time.size() > 0 && request.resource.data.time.size() < 50 &&
        request.resource.data.date is string && request.resource.data.date.size() > 0 && request.resource.data.date.size() < 50 &&
        request.resource.data.seats is int && request.resource.data.seats > 0 && request.resource.data.seats <= 50 &&
        request.resource.data.bookedSeats is int && request.resource.data.bookedSeats >= 0 && request.resource.data.bookedSeats <= request.resource.data.seats &&
        request.resource.data.type in ['group', 'battle', 'lab'] &&
        request.resource.data.mentor is string && request.resource.data.mentor.size() > 0 && request.resource.data.mentor.size() < 100 &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && (
        isOwner() || 
        resource.data.createdBy == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedSeats']) && 
         request.resource.data.bookedSeats is int &&
         request.resource.data.bookedSeats >= 0 && 
         request.resource.data.bookedSeats <= resource.data.seats &&
         (request.resource.data.bookedSeats == resource.data.bookedSeats + 1 || request.resource.data.bookedSeats == resource.data.bookedSeats - 1)
        )
      );
      allow delete: if request.auth != null && (resource.data.createdBy == request.auth.uid || isOwner());
    }

    match /subscription_requests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || hasPermission('manage_users'));
      allow create: if request.auth != null;
      allow update, delete: if hasPermission('manage_users') || isOwner();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isOwner());
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isOwner());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
