rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check for Admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chat System (Support)
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (request.auth.uid == chatId || isAdmin());
      match /messages/{messageId} {
        allow read, write: if request.auth != null && (request.auth.uid == chatId || isAdmin());
      }
    }

    // Public Content (Subjects)
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      match /resources/{resourceId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }
    
    // Notifications: Read all authenticated, Admin Write
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Admin Whitelist - needed for AuthContext to check and auto-promote
    match /whitelisted_admins/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Banners - Public read for announcements
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // System & Logs
    match /logs/{logId} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create: if request.auth != null; // Allow users to log errors
    }
    
    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
