rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function currentUserRole() {
      return ('role' in request.auth.token) ? request.auth.token.role :
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'student');
    }

    function isOwner() {
      return request.auth != null && currentUserRole() == 'owner';
    }

    function isAdminUser() {
      return request.auth != null &&
        (currentUserRole() == 'admin' || currentUserRole() == 'owner');
    }

    function hasPermission(permission) {
      return request.auth != null && (
        isOwner() ||
        (
          'permissions' in request.auth.token &&
          request.auth.token.permissions is list &&
          permission in request.auth.token.permissions
        )
      );
    }

    function isOwnChat(chatId) {
      return request.auth != null &&
        (chatId == request.auth.uid || chatId == request.auth.uid + '_support');
    }

    function isNotificationRecipient(target) {
      return request.auth != null && (
        target == request.auth.uid ||
        target == 'all' ||
        (target == 'admins' && isAdminUser())
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || hasPermission('manage_users'));

      allow create: if false;

      allow update: if request.auth != null && (
        isOwner() ||
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isWhitelisted', 'status']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points']) ||
            (
              request.resource.data.points is int &&
              (
                (!('points' in resource.data) && (request.resource.data.points == 2 || request.resource.data.points == 10 || request.resource.data.points == 25)) ||
                (('points' in resource.data) && (
                  request.resource.data.points - resource.data.points == 2 ||
                  request.resource.data.points - resource.data.points == 10 ||
                  request.resource.data.points - resource.data.points == -10 ||
                  request.resource.data.points - resource.data.points == 25
                ))
              )
            )
          )
        ) ||
        (hasPermission('manage_users') && resource.data.role in ['student', 'moderator'] && 
          request.resource.data.role in ['student', 'admin', 'moderator']) ||
        (hasPermission('manage_users') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );


      allow delete: if isOwner() || (hasPermission('manage_users') && resource.data.role != 'owner');

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow read, create, update: if request.auth != null &&
        (isOwnChat(chatId) || hasPermission('access_inbox'));
      allow delete: if request.auth != null &&
        (isOwnChat(chatId) || hasPermission('delete_chats'));

      match /messages/{messageId} {
        allow read, create, update: if request.auth != null &&
          (isOwnChat(chatId) || hasPermission('access_inbox'));
        allow delete: if request.auth != null &&
          (isOwnChat(chatId) || hasPermission('delete_chats'));
      }
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if hasPermission('manage_subjects');

      match /resources/{resourceId} {
        allow read: if request.auth != null;
        allow write: if hasPermission('manage_resources');
      }
    }

    match /global_chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.role in ['student', 'moderator', 'admin', 'owner'] &&
        request.resource.data.createdAt == request.time;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || hasPermission('delete_chats') || isOwner());
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        (hasPermission('manage_announcements') || isNotificationRecipient(resource.data.target));

      allow create: if request.auth != null && (
        hasPermission('manage_announcements') ||
        request.resource.data.target == request.auth.uid
      );

      allow update: if request.auth != null && (
        hasPermission('manage_announcements') ||
        (
          isNotificationRecipient(resource.data.target) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy is list &&
          request.auth.uid in request.resource.data.readBy
        )
      );

      allow delete: if request.auth != null && (
        hasPermission('manage_announcements') ||
        resource.data.target == request.auth.uid
      );
    }

    match /whitelisted_admins/{email} {
      allow read: if request.auth != null &&
        (request.auth.token.email == email || hasPermission('manage_users'));
      allow write: if hasPermission('manage_users');
    }

    match /admin_approvals/{requestId} {
      allow read, write: if hasPermission('manage_subjects') || hasPermission('manage_users');
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if hasPermission('manage_announcements');
    }

    match /settings/api_keys {
      allow read, write: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if settingId in ['global', 'platform_stats', 'banners'];
      allow write: if isOwner();
    }

    match /analytics_logs/{logId} {
      allow read: if hasPermission('view_analytics') || 
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['userId', 'timestamp']) &&
        request.resource.data.keys().size() < 15 &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'guest');
    }

    match /user_stats/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdminUser());
      allow create: if request.auth != null && (
        isOwner() || 
        (request.auth.uid == userId &&
         (!('pageViews' in request.resource.data) || request.resource.data.pageViews == 1) &&
         (!('fileOpens' in request.resource.data) || request.resource.data.fileOpens == 1) &&
         (!('subjectOpens' in request.resource.data) || request.resource.data.subjectOpens == 1) &&
         (!('totalActions' in request.resource.data) || request.resource.data.totalActions == 1)
        )
      );
      allow update: if request.auth != null && (
        isOwner() ||
        (request.auth.uid == userId &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pageViews']) || 
          (request.resource.data.pageViews is int && request.resource.data.pageViews == (('pageViews' in resource.data) ? resource.data.pageViews + 1 : 1))) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fileOpens']) || 
          (request.resource.data.fileOpens is int && request.resource.data.fileOpens == (('fileOpens' in resource.data) ? resource.data.fileOpens + 1 : 1))) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subjectOpens']) || 
          (request.resource.data.subjectOpens is int && request.resource.data.subjectOpens == (('subjectOpens' in resource.data) ? resource.data.subjectOpens + 1 : 1))) &&
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalActions']) || 
          (request.resource.data.totalActions is int && request.resource.data.totalActions == (('totalActions' in resource.data) ? resource.data.totalActions + 1 : 1)))
        )
      );
    }

    match /error_logs/{errorId} {
      allow read, delete: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['message', 'timestamp']) &&
        request.resource.data.keys().size() < 10;
    }

    match /logs/{logId} {
      allow read, write: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['action', 'details']) &&
        request.resource.data.keys().size() < 20 &&
        request.resource.data.action is string &&
        request.resource.data.details is string;
    }

    match /system_errors/{errorId} {
      allow read, write: if hasPermission('view_analytics');
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['message']) &&
        request.resource.data.keys().size() < 20 &&
        request.resource.data.message is string &&
        request.resource.data.timestamp is timestamp;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
